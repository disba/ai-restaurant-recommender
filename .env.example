# Copy to .env. No API key is needed for local inference.
TEXT_LLM_PROVIDER=ollama
TEXT_LLM_MODEL=qwen3:8b
VISION_LLM_PROVIDER=ollama
VISION_LLM_MODEL=qwen2.5vl:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

TEXT_EMBED_MODEL=all-MiniLM-L6-v2
CLIP_MODEL=openai/clip-vit-base-patch32
FUSION_WEIGHT_TEXT=0.6
FUSION_WEIGHT_IMAGE=0.4

TRACING_ENABLED=true
PHOENIX_URL=http://localhost:6006
PHOENIX_PROJECT=restaurant-recommender

# Optional OpenAI-compatible provider. Enable only if you intend to send
# prompts, retrieved records, and/or images to that external provider.
# Cloud usage may incur charges. Model/tool/vision support varies by provider.
# TEXT_LLM_PROVIDER=openai_compatible
# TEXT_LLM_MODEL=your-tool-capable-model
# TEXT_LLM_API_KEY=replace-locally
# TEXT_LLM_BASE_URL=https://api.openai.com/v1
# VISION_LLM_PROVIDER=openai_compatible
# VISION_LLM_MODEL=your-vision-model
# VISION_LLM_API_KEY=replace-locally
# VISION_LLM_BASE_URL=https://api.openai.com/v1
